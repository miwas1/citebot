# CiteBot runs fully offline by default. Most settings have safe defaults in
# app/core/config.py and docker-compose.yml; add an override only when needed.

# Use `production` on a private server. Production requires both API keys.
APP_ENV=development
RUNTIME_MODE=offline

# Host-facing configuration
CITEBOT_PORT=8000
CITEBOT_HTTP_PORT=80
DOZZLE_HTTP_PORT=8888
MODEL_ARTIFACT_ROOT=./models
POSTGRES_PASSWORD=change-this-local-database-password

# Networked model provisioning overrides. Provisioning downloads the selected
# upstream GGUF and stores it at models/phi-4-mini-instruct-q4.gguf for runtime.
EMBEDDING_MODEL_REPOSITORY=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=main
EMBEDDING_SERVED_MODEL_NAME=BAAI/bge-small-en-v1.5
LLM_MODEL_REPOSITORY=bartowski/microsoft_Phi-4-mini-instruct-GGUF
LLM_MODEL_REVISION=main
LLM_MODEL_FILENAME=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf
HF_ENDPOINT=https://huggingface.co
HF_MAX_RETRIES=5
HF_RETRY_BACKOFF_SECONDS=2

# On the first offline startup, queue the bundled sample corpus for ingestion.
SAMPLE_CORPUS_PATH=./data/sample_corpus
SAMPLE_CORPUS_AUTO_INGEST=true

# Generate two different random values for a private-server deployment.
RESEARCH_API_KEY=
ADMIN_API_KEY=
# Keep browser/API key authentication off during local testing.
API_KEY_AUTH_ENABLED=false
