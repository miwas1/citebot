APP_NAME=CiteBot
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api/v1
RUNTIME_MODE=offline
API_BIND_HOST=127.0.0.1
LOCAL_SERVICE_HOSTS=embedding,llm,qdrant,ocr-worker,localhost,127.0.0.1,::1
DATABASE_URL=sqlite+aiosqlite:///./citebot.db
SQLITE_BUSY_TIMEOUT_MS=5000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=citebot_chunks_qwen3_v2
ENABLE_QDRANT=true
ENABLE_PGVECTOR=false
OBJECT_STORAGE_PATH=./storage/raw_documents
STRUCTURED_DOCUMENT_PATH=./storage/structured_documents
SPARSE_INDEX_PATH=./storage/sparse_index.json
OPENAI_API_KEY=
GEMINI_API_KEY=
VECTOR_BACKEND=qdrant
DOCUMENT_PARSER=auto
OCR_PROVIDER=paddleocr
OCR_MODEL_PATH=./models/paddleocr
OCR_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL_NAME=PP-OCRv5_mobile_rec
OCR_FALLBACK_PROVIDER=tesseract
OCR_LANGUAGES=en
OCR_MIN_NATIVE_TEXT_COVERAGE=0.60
OCR_MIN_CONFIDENCE=0.75
OCR_MAX_PAGES=500
OCR_CONCURRENCY=1
MAX_INPUT_BYTES=52428800
INGESTION_EXECUTION_MODE=foreground
INGESTION_WORKER_ID=citebot-worker
QUEUE_LEASE_SECONDS=300
QUEUE_POLL_SECONDS=1
INGESTION_MAX_ATTEMPTS=3
EMBEDDING_PROVIDER=local-http
EMBEDDING_BASE_URL=http://embedding:8081
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_VERSION=qwen3-0.6b-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ANSWER_PROVIDER=llama-cpp
ANSWER_MODEL=phi-4-mini-instruct-q4
LLM_BASE_URL=http://llm:8082/v1
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_TOKENS=8192
LLM_GENERATION_CONCURRENCY=1
MODEL_MANIFEST_PATH=./models/manifest.lock.json
# One-time provisioning sources. `make local-setup` resolves `main` to a commit
# and records that immutable revision and artifact checksum in manifest.lock.json.
MODEL_ARTIFACT_ROOT=./models
EMBEDDING_MODEL_REPOSITORY=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=main
LLM_MODEL_REPOSITORY=bartowski/microsoft_Phi-4-mini-instruct-GGUF
LLM_MODEL_REVISION=main
LLM_MODEL_FILENAME=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf
OCR_DETECTION_MODEL_REPOSITORY=PaddlePaddle/PP-OCRv5_mobile_det
OCR_DETECTION_MODEL_REVISION=main
OCR_RECOGNITION_MODEL_REPOSITORY=PaddlePaddle/PP-OCRv5_mobile_rec
OCR_RECOGNITION_MODEL_REVISION=main
GEMINI_ANSWER_MODEL=gemini-3-flash-preview
TAVILY_API_KEY=
EVALUATION_EVALUATOR_PROVIDER=local
EVALUATION_EVALUATOR_MODEL=phi-4-mini-instruct-q4
RESEARCH_API_KEY=
ADMIN_API_KEY=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
